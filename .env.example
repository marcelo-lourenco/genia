# ==============================================================================
# FamilySearch Autonomous AI Agent - Environment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=development
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# FamilySearch Developer Platform (OAuth2)
# ------------------------------------------------------------------------------
# Environment: 'sandbox' (https://identbeta.familysearch.org) or 'production' (https://ident.familysearch.org)
FAMILYSEARCH_ENV=sandbox

# Developer App Key (Client ID) obtained from FamilySearch Developer Portal
FAMILYSEARCH_CLIENT_ID=your_familysearch_developer_client_id_here

# Optional: Active Session Token (SessionId / Bearer Token) to bypass OAuth2 redirect
FAMILYSEARCH_SESSION_ID=

# Optional Client Secret (for confidential clients, leave empty if public client PKCE)
FAMILYSEARCH_CLIENT_SECRET=your_familysearch_client_secret_optional

# OAuth2 Redirect URI (must match the URI registered in FamilySearch Developer Console)
FAMILYSEARCH_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ------------------------------------------------------------------------------
# Google Gemini AI (Multimodal / Vision / Paleography OCR)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_google_gemini_api_key_here

# ------------------------------------------------------------------------------
# Security & Session Storage
# ------------------------------------------------------------------------------
# Minimum 32 characters secret key used to sign and encrypt session cookies
SESSION_SECRET=super_secret_encryption_key_at_least_32_characters_long
